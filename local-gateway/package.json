{
  "name": "taskflow-local-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Passerelle locale TaskFlow : seul composant autorisé à parler à PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "node -r ts-node/register src/scripts/migrate.ts",
    "test": "node -r ts-node/register --test --test-concurrency=1 src/tests/gateway.security.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
