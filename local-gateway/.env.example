# Écoute uniquement sur la machine. Le tunnel Cloudflare cible cette adresse.
HOST=127.0.0.1
PORT=4000
NODE_ENV=development

# Même valeur que LOCAL_GATEWAY_TOKEN du backend Render.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_GATEWAY_TOKEN=

# PostgreSQL local. Ne jamais ouvrir 5432 sur Internet.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_app
DB_PASSWORD=
DB_SSL=false
DB_CONNECTION_TIMEOUT_MS=5000

# Limite simple par adresse source (cloudflared apparaît comme 127.0.0.1)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
