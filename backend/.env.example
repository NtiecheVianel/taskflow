# Port d'écoute du serveur Backend API (Render fournit PORT automatiquement)
PORT=5000
NODE_ENV=development

# Clé secrète pour signer les JWT. Obligatoire sur Render.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Passerelle locale exposée par Cloudflare Quick Tunnel.
# Ne pas mettre d'identifiants PostgreSQL ici : Render ne parle pas à PostgreSQL.
LOCAL_GATEWAY_URL=https://votre-tunnel.trycloudflare.com
LOCAL_GATEWAY_TOKEN=

# Anciens noms encore lus s'ils sont déjà définis sur Render
# GATEWAY_URL=
# GATEWAY_SECRET=

# Origine du frontend Vercel. Plusieurs origines possibles, séparées par des virgules.
# * autorise toutes les origines (comportement historique).
FRONTEND_URL=https://votre-projet.vercel.app

# Délai d'attente des appels vers la passerelle, en millisecondes
GATEWAY_TIMEOUT_MS=8000

# PostgreSQL direct : UNIQUEMENT pour le développement local ou les tests.
# Ne pas définir ces variables sur Render.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_app
DB_PASSWORD=
DB_SSL=false
