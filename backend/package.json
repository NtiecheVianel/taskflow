{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "description": "API Backend TaskFlow déployée sur Cloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "node -r ts-node/register src/scripts/migrate.ts",
    "test": "node -r ts-node/register --test --test-concurrency=1 src/tests/public-api.test.ts src/tests/gateway-down.test.ts src/tests/ownership.test.ts src/tests/render-guard.test.ts",
    "test:integration": "node -r ts-node/register --test --test-concurrency=1 src/tests/hybrid.integration.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "typescript": "^5.5.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
